# Atelier environment defaults (all optional)
#
# Everything here is only a FIRST-RUN DEFAULT that the Settings panel pre-fills.
# The live values live in your browser's localStorage, so you can change them in
# the UI without touching this file. Vite only exposes vars prefixed with VITE_.
#
# Copy this file to `.env` if you want to override the defaults:
#     cp .env.example .env
#
# NOTE: if you run Atelier on the SAME machine as Penpot (the recommended setup),
# localhost is correct. If Atelier runs on a different machine, replace localhost
# with the Penpot host's LAN address.

# Penpot MCP endpoint.
# Self-hosted Penpot proxies MCP through its frontend port at /mcp/stream.
# It MUST include ?userToken=<key> or Penpot rejects every file operation, because
# the official penpot-mcp container always runs in multi-user mode.
# Generate the key in Penpot under: Your account -> Integrations -> MCP Server
VITE_DEFAULT_MCP_URL=http://localhost:9001/mcp/stream?userToken=

# OpenAI-compatible inference endpoint used to write the Penpot Plugin API code.
VITE_DEFAULT_LLM_BASE_URL=https://api.particle.ai/v1
VITE_DEFAULT_LLM_MODEL=deepseek-v4.1-flash